{
	"name": "density-doppler",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "biome format --write . && prettier --write \"**/*.astro\"",
		"lint": "biome lint --write .",
		"check": "biome check --write . && prettier --write \"**/*.astro\"",
		"format:astro": "prettier --write \"**/*.astro\"",
		"og": "astro build && bash scripts/og-export.sh"
	},
	"dependencies": {
		"@nyt87/tokens": "0.1.0",
		"@nyt87/ui": "0.2.0",
		"astro": "7.4.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2"
	}
}
