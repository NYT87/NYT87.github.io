---
/** biome-ignore-all lint/correctness/noUnusedVariables: they are used in the layout for structured data */
interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title,
	description = "NYT87 is a remote software development company building reliable web applications, backend systems, and cloud infrastructure.",
	image = "/assets/brand.png",
	noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
const robotsContent = noindex ? "noindex,nofollow" : "index,follow";
---

<!doctype html>
<html lang="en-US">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f2ed" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15181c" />
		<meta name="color-scheme" content="light dark" />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="NYT87" />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap"
		/>
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main-content" class="skip-link">
			Skip to content
		</a>
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Manrope Fallback";
		font-style: normal;
		font-weight: 400;
		src: local("Arial");
		ascent-override: 90%;
		descent-override: 22%;
		line-gap-override: 0%;
		size-adjust: 106%;
	}

	@font-face {
		font-family: "Space Grotesk Fallback";
		font-style: normal;
		font-weight: 500;
		src: local("Arial");
		ascent-override: 94%;
		descent-override: 20%;
		line-gap-override: 0%;
		size-adjust: 102%;
	}

	/* Tokens are documented in design-system/nyt87/MASTER.md */
	:root {
		color-scheme: light dark;
		--bg: oklch(0.97 0.01 70);
		--surface: oklch(0.99 0.008 70);
		--surface-strong: oklch(1 0.004 70);
		--text: oklch(0.2 0.01 70);
		--muted: oklch(0.46 0.015 70);
		--border: oklch(0.84 0.01 70 / 0.82);
		--line-strong: oklch(0.74 0.014 70 / 0.9);
		--brand: oklch(0.63 0.18 45);
		--brand-strong: oklch(0.5 0.16 43);
		--brand-fill: oklch(0.55 0.17 44);
		--brand-text: oklch(0.53 0.16 43);
		--on-brand: oklch(0.99 0.004 70);
		--accent: oklch(0.5 0.08 208);
		--accent-wash: color-mix(in oklch, var(--accent) 7%, transparent);
		--focus-ring: oklch(0.72 0.16 45 / 0.9);
		--shadow: 0 16px 34px oklch(0.24 0.02 60 / 0.08);
		--radius-md: 12px;
		--radius-sm: 8px;
		--font-heading: "Space Grotesk", "Space Grotesk Fallback", sans-serif;
		--font-body: "Manrope", "Manrope Fallback", sans-serif;
		--font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
		--nav-height: 4.5rem;
		/* Fixed navbar height plus breathing room, for anchor jumps and keyboard focus */
		--section-anchor-offset: 6rem;
		--max-width: 1120px;
		--page-gutter: clamp(1rem, 3vw, 1.4rem);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		min-height: 100%;
	}

	html {
		scroll-padding-top: var(--section-anchor-offset);
	}

	body {
		font-family: var(--font-body);
		color: var(--text);
		background: var(--bg);
		line-height: 1.65;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-heading);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0;
		overflow-wrap: break-word;
		text-wrap: balance;
	}

	p {
		margin: 0;
		color: var(--muted);
		font-size: clamp(1rem, 0.96rem + 0.2vw, 1.1rem);
		overflow-wrap: break-word;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	img,
	picture {
		max-width: 100%;
	}

	.container {
		width: min(100%, calc(var(--max-width) + (var(--page-gutter) * 2)));
		padding-inline: var(--page-gutter);
		margin-inline: auto;
	}

	/* Document-style sections: a sticky index label on the left, content on the right */
	.section {
		padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
	}

	/* Full-width rule aligned to the content edges, not the gutters */
	.section > .container {
		padding-top: clamp(1.5rem, 3vw, 2.25rem);
		background: linear-gradient(var(--line-strong), var(--line-strong)) top center /
			calc(100% - var(--page-gutter) * 2) 1px no-repeat;
	}

	.section-grid {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
		gap: clamp(1.5rem, 4vw, 4rem);
	}

	.section-index {
		position: sticky;
		top: var(--section-anchor-offset);
		align-self: start;
		display: flex;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.section-index span:first-child {
		color: var(--brand-text);
	}

	.section-body {
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
		min-width: 0;
	}

	.section-title {
		font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
		max-width: 20ch;
	}

	.lead {
		color: var(--text);
		font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
		max-width: 62ch;
	}

	.mono-label {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	/* Indexed rows shared by services, work and approach steps */
	.index-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--border);
	}

	.index-list > li {
		border-top: 1px solid var(--border);
	}

	.text-link {
		color: var(--accent);
		font-family: var(--font-heading);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color 0.2s ease;
	}

	.text-link:hover {
		color: var(--text);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0.75rem 1.25rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.btn-primary {
		color: var(--on-brand);
		background: linear-gradient(135deg, var(--brand-strong), var(--brand-fill));
		box-shadow: 0 6px 16px color-mix(in oklch, var(--brand) 20%, transparent);
	}

	.btn-primary:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 22px color-mix(in oklch, var(--brand) 26%, transparent);
	}

	.btn-outline {
		color: var(--text);
		border-color: var(--line-strong);
		background: transparent;
	}

	.btn-outline:hover {
		border-color: var(--accent);
		background: var(--accent-wash);
	}

	.btn:active {
		transform: translateY(1px);
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: 0;
		transform: translateY(-140%);
		z-index: 200;
		padding: 0.7rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--text);
		color: var(--bg);
		font-weight: 700;
		transition: transform 0.2s ease;
	}

	.skip-link:focus-visible {
		transform: translateY(1rem);
	}

	:focus-visible {
		outline: 3px solid var(--focus-ring);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.reveal {
		animation: fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.reveal-delay-1 {
		animation-delay: 0.08s;
	}

	.reveal-delay-2 {
		animation-delay: 0.16s;
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			animation-duration: 0.01ms !important;
			animation-delay: 0s !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: oklch(0.18 0.01 250);
			--surface: oklch(0.23 0.01 250);
			--surface-strong: oklch(0.26 0.012 250);
			--text: oklch(0.94 0.01 80);
			--muted: oklch(0.77 0.015 80);
			--border: oklch(0.4 0.015 250 / 0.7);
			--line-strong: oklch(0.55 0.015 250 / 0.8);
			--brand-text: oklch(0.75 0.15 50);
			--accent: oklch(0.76 0.09 208);
			--focus-ring: oklch(0.73 0.16 45 / 0.95);
			--shadow: 0 18px 38px oklch(0.02 0.01 250 / 0.34);
		}
	}

	@media (max-width: 900px) {
		.section-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.section-index {
			position: static;
		}
	}

	@media (max-width: 768px) {
		:root {
			--nav-height: 4rem;
			--section-anchor-offset: 5rem;
			--page-gutter: 1rem;
		}
	}
</style>
