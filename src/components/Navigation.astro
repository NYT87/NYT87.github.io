---
/** biome-ignore-all lint/correctness/noUnusedImports: they are used in the template */
/** biome-ignore-all lint/correctness/noUnusedVariables: they are used in the template */
/**
 * The primary navigation: the shared site header from @nyt87/ui, as plain HTML.
 * Its only script is the 0.45 KB menu behaviour that opens the mobile panel.
 */
import { getImage, Image } from "astro:assets";
import logoIcon from "../assets/brand/logo-icon.png";
import logoText from "../assets/brand/logo-text.png";
import logoTextWhite from "../assets/brand/logo-text-white.png";

interface Props {
	/** Which primary destination the current page belongs to, for aria-current */
	current?: "projects" | "team";
}

const { current } = Astro.props;

const links = [
	{ label: "Services", href: "/#services", page: undefined },
	{ label: "Work", href: "/#projects", page: "projects" },
	{ label: "Approach", href: "/#about", page: undefined },
	{ label: "Team", href: "/#team", page: "team" },
];

const logoTextDark = await getImage({
	src: logoTextWhite,
	height: 24,
	densities: [1, 2],
});
---

<div class="site-nav">
	<header class="ds-header">
		<div class="ds-container ds-header__bar">
			<a class="ds-brand" href="/" aria-label="NYT87 home">
				<span class="ds-brand__mark" aria-hidden="true">
					<Image src={logoIcon} alt="" height={28} densities={[1, 2]} loading="eager" />
				</span>
				<span class="ds-brand__name">
					<picture>
						<source
							srcset={logoTextDark.srcSet.attribute || logoTextDark.src}
							media="(prefers-color-scheme: dark)"
						/>
						<Image src={logoText} alt="" height={24} densities={[1, 2]} loading="eager" />
					</picture>
				</span>
			</a>
			<nav class="ds-header__nav" aria-label="Primary">
				{links.map((l) => (
					<a
						class="ds-header__link"
						href={l.href}
						aria-current={l.page && l.page === current ? "page" : undefined}
					>
						{l.label}
					</a>
				))}
			</nav>
			<div class="ds-header__actions">
				<a class="ds-btn ds-btn--secondary ds-btn--md" href="/#contact">
					Contact
				</a>
				<button
					class="ds-header__menu"
					type="button"
					aria-expanded="false"
					aria-controls="nav-panel"
					aria-label="Open navigation menu"
					data-label-open="Open navigation menu"
					data-label-close="Close navigation menu"
				>
					<span class="ds-header__burger" aria-hidden="true"></span>
				</button>
			</div>
		</div>
		<nav id="nav-panel" class="ds-header__panel" aria-label="Primary (menu)" hidden>
			<div class="ds-container">
				{links.map((l) => (
					<a
						class="ds-header__link"
						href={l.href}
						aria-current={l.page && l.page === current ? "page" : undefined}
					>
						{l.label}
					</a>
				))}
			</div>
		</nav>
		<noscript>
			<nav class="ds-header__panel" aria-label="Primary (no script)">
				<div class="ds-container">
					{links.map((l) => (
						<a
							class="ds-header__link"
							href={l.href}
							aria-current={l.page && l.page === current ? "page" : undefined}
						>
							{l.label}
						</a>
					))}
				</div>
			</nav>
		</noscript>
	</header>
</div>

<script>
	// Client script (bundled by Astro): opens and closes the mobile menu. 0.45 KB gzipped, no framework.
	import "@nyt87/ui/menu";
</script>

<style>
	/* Fixed, so page sections keep their padding-top of var(--nav-height) */
	.site-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 60;
	}
</style>
