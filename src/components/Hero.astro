---
// biome-ignore lint/correctness/noUnusedVariables: it is used in the template
const principles = [
	{
		term: "Delivery",
		detail:
			"A small senior team, direct communication, and milestones tied to shipping decisions.",
	},
	{
		term: "Systems",
		detail:
			"Web products, APIs, platform services, and infrastructure built to stay maintainable.",
	},
	{
		term: "Mode",
		detail:
			"Remote-first collaboration with documented decisions, clear owners, and steady delivery.",
	},
];
---

<header class="hero">
	<div class="container">
		<p class="mono-label hero-meta reveal">
			Remote software studio <span aria-hidden="true">/</span> Product, backend &amp; infrastructure
		</p>
		<h1 class="reveal">Designing and engineering products that survive real&#8209;world scale.</h1>
		<div class="hero-body">
			<div class="hero-intro reveal reveal-delay-1">
				<p class="lead">
					NYT87 helps teams deliver product, backend, and infrastructure work that cannot afford
					weak execution, unclear ownership, or expensive rewrites later.
				</p>
				<div class="hero-actions">
					<a href="#contact" class="btn btn-primary">
						Discuss your project
					</a>
					<a href="#projects" class="btn btn-outline">
						See selected work
					</a>
				</div>
			</div>
			<div class="hero-spec reveal reveal-delay-2">
				<p class="mono-label">How we work</p>
				<dl>
					{principles.map((item) => (
						<div class="spec-row">
							<dt class="mono-label">{item.term}</dt>
							<dd>{item.detail}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</div>
</header>

<style>
	.hero {
		padding-top: calc(var(--nav-height) + clamp(3rem, 8vw, 6.5rem));
		padding-bottom: clamp(3.5rem, 7vw, 6rem);
	}

	.hero-meta span {
		color: var(--brand-text);
		padding-inline: 0.35rem;
	}

	.hero h1 {
		margin-top: clamp(1.25rem, 2.5vw, 2rem);
		font-size: clamp(2.6rem, 1.6rem + 4.4vw, 5.6rem);
		line-height: 1.02;
		letter-spacing: -0.04em;
		max-width: 16ch;
	}

	.hero-body {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.hero-intro {
		display: grid;
		gap: 1.75rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-spec {
		display: grid;
		gap: 0.9rem;
	}

	.hero-spec dl {
		margin: 0;
		border-top: 1px solid var(--line-strong);
	}

	.spec-row {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 0.9rem;
		border-bottom: 1px solid var(--border);
	}

	.spec-row dt {
		color: var(--text);
		padding-top: 0.15rem;
	}

	.spec-row dd {
		margin: 0;
		color: var(--muted);
		font-size: 0.98rem;
	}

	@media (max-width: 900px) {
		.hero-body {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.hero-actions .btn {
			flex: 1 1 100%;
		}

		.spec-row {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
