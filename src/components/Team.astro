---
/** biome-ignore-all lint/correctness/noUnusedImports: they are used in the template */
import { Image } from "astro:assets";
import joseImg from "../assets/jose.jpeg";
---

<section id="team" class="section" aria-labelledby="team-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>04</span>
			<span>Team</span>
		</p>
		<div class="section-body">
			<h2 id="team-title" class="section-title">
				Senior engineering leadership with product discipline.
			</h2>
			<article class="profile">
				<Image
					src={joseImg}
					alt="Portrait of José Miguel"
					width={160}
					height={160}
					densities={[1, 2]}
					class="profile-photo"
				/>
				<div class="profile-body">
					<div class="profile-head">
						<h3>José Miguel</h3>
						<p class="mono-label">Founder · CTO &amp; Senior Software Engineer</p>
					</div>
					<p>
						José Miguel Navarro Iglesias builds software at the intersection of product delivery,
						reliable architecture, and scaling strategy. He has led backend and full-stack
						initiatives that turn ambitious ideas into fast, stable systems ready for growth.
					</p>
					<a
						href="https://www.linkedin.com/in/jm8nav/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-link"
					>
						LinkedIn profile
					</a>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.profile {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: start;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.profile-photo {
		width: 160px;
		height: 160px;
		object-fit: cover;
		border-radius: var(--radius-md);
		border: 1px solid var(--border);
	}

	.profile-body {
		display: grid;
		gap: 1rem;
		justify-items: start;
		max-width: 62ch;
	}

	.profile-head {
		display: grid;
		gap: 0.4rem;
	}

	.profile-head h3 {
		font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
	}

	@media (max-width: 600px) {
		.profile {
			grid-template-columns: 1fr;
		}

		.profile-photo {
			width: 112px;
			height: 112px;
		}
	}
</style>
