<section id="contact" class="section contact" aria-labelledby="contact-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>05</span>
			<span>Contact</span>
		</p>
		<div class="section-body">
			<h2 id="contact-title" class="contact-title">
				Bring us the problem you are trying to solve.
			</h2>
			<p class="lead">
				If you need senior engineering judgment on product, backend, or infrastructure work, start
				with an email describing where you are and what is at stake.
			</p>
			<div class="contact-actions">
				<a href="mailto:nyt87@proton.me" class="btn btn-primary">
					Email nyt87@proton.me
				</a>
				<a
					href="https://github.com/NYT87"
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline"
				>
					GitHub
				</a>
				<a
					href="https://www.linkedin.com/in/jm8nav/"
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline"
				>
					LinkedIn
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-title {
		font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.4rem);
		line-height: 1.04;
		letter-spacing: -0.04em;
		max-width: 16ch;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@media (max-width: 520px) {
		.contact-actions .btn-primary {
			flex: 1 1 100%;
		}
	}
</style>
