---
// biome-ignore lint/correctness/noUnusedVariables: it is used in the template
const services = [
	{
		title: "Web Applications",
		description:
			"Product-grade frontends and full-stack experiences built for performance, usability, and long-term maintainability.",
	},
	{
		title: "Backend Systems",
		description:
			"Scalable APIs and core services with observability, domain modeling, and resilient integrations.",
	},
	{
		title: "Cloud Infrastructure",
		description:
			"Infrastructure and delivery pipelines that keep deployments reliable, secure, and easy to evolve.",
	},
];
---

<section id="services" class="section" aria-labelledby="services-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>01</span>
			<span>Services</span>
		</p>
		<div class="section-body">
			<h2 id="services-title" class="section-title">
				Engineering support across product delivery, systems, and infrastructure.
			</h2>
			<ol class="index-list service-list">
				{services.map((service, index) => (
					<li class="service-row">
						<span class="mono-label service-num">{`0${index + 1}`}</span>
						<h3>{service.title}</h3>
						<p>{service.description}</p>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.service-row {
		display: grid;
		grid-template-columns: 3rem minmax(0, 4fr) minmax(0, 6fr);
		gap: 1.5rem;
		align-items: baseline;
		padding: clamp(1.25rem, 2.5vw, 1.75rem) 0.5rem;
		transition: background-color 0.2s ease;
	}

	.service-row:hover {
		background: var(--accent-wash);
	}

	.service-num {
		color: var(--brand-text);
	}

	.service-row h3 {
		font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
	}

	.service-row p {
		max-width: 48ch;
	}

	@media (max-width: 768px) {
		.service-row {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			gap: 0.5rem 1rem;
		}

		.service-row p {
			grid-column: 2;
		}
	}
</style>
