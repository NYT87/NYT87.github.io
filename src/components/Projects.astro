---
/** biome-ignore-all lint/correctness/noUnusedImports: they are used in the template */
/** biome-ignore-all lint/correctness/noUnusedVariables: they are used in the template */
import { getCollection } from "astro:content";
import WorkList from "./WorkList.astro";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="section" aria-labelledby="projects-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>02</span>
			<span>Work</span>
		</p>
		<div class="section-body">
			<h2 id="projects-title" class="section-title">
				Recent work built for everyday use, not demo-day polish.
			</h2>
			<WorkList projects={projects} />
			<div class="work-note">
				<p>
					Client codebases such as Criptan's are private, so only the studio's own projects and
					upstream contributions are public. We can walk through client work in a conversation.
				</p>
				<div class="work-note-links">
					<a href="/projects/" class="text-link">
						All projects
					</a>
					<a href="#contact" class="text-link">
						Ask about client work
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.work-note {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	.work-note p {
		max-width: 56ch;
	}

	.work-note-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}
</style>
