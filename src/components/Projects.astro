---
// biome-ignore lint/correctness/noUnusedVariables: it is used in the template
const projects = [
	{
		name: "Booba Pass",
		kind: "Open source · Web app",
		description:
			"A centralized wallet for airline loyalty information with QR and barcode support, designed for quick access and practical day-to-day use.",
		liveUrl: "https://nyt87.github.io/booba-pass/",
		repoUrl: "https://github.com/NYT87/booba-pass",
	},
	{
		name: "OpenTrack Viewer",
		kind: "Open source · PWA",
		description:
			"A privacy-first, client-side web app and PWA for viewing activity tracking files, with everything processed locally in the browser.",
		liveUrl: "https://nyt87.github.io/opentrack-viewer/",
		repoUrl: "https://github.com/NYT87/opentrack-viewer",
	},
	{
		name: "Agents PP",
		kind: "Open source · Claude Code plugin",
		description:
			"Pair-programming workflows for coding agents: one agent codes while an independent reviewer comments, looping until every comment is resolved.",
		repoUrl: "https://github.com/NYT87/agents-pp",
	},
];
---

<section id="projects" class="section" aria-labelledby="projects-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>02</span>
			<span>Work</span>
		</p>
		<div class="section-body">
			<h2 id="projects-title" class="section-title">
				Recent work built for everyday use, not demo-day polish.
			</h2>
			<ul class="index-list work-list">
				{projects.map((project) => (
					<li class="work-row">
						<div class="work-head">
							<h3>{project.name}</h3>
							<p class="mono-label">{project.kind}</p>
						</div>
						<p class="work-desc">{project.description}</p>
						<div class="work-links">
							{project.liveUrl && (
								<a
									href={project.liveUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="text-link"
								>
									Live app<span class="visually-hidden"> for {project.name}</span>
								</a>
							)}
							<a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="text-link">
								Code<span class="visually-hidden"> for {project.name}</span>
							</a>
						</div>
					</li>
				))}
			</ul>
			<div class="work-note">
				<p>
					Private client systems and internal delivery tools are not public, but we can walk through
					relevant work in a conversation.
				</p>
				<a href="#contact" class="text-link">
					Ask about client work
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.work-row {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
		gap: 1.5rem;
		align-items: baseline;
		padding: clamp(1.25rem, 2.5vw, 1.75rem) 0.5rem;
		transition: background-color 0.2s ease;
	}

	.work-row:hover {
		background: var(--accent-wash);
	}

	.work-head {
		display: grid;
		gap: 0.4rem;
	}

	.work-head h3 {
		font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
	}

	.work-desc {
		max-width: 52ch;
	}

	.work-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
		font-size: 0.95rem;
	}

	.work-links a {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
	}

	.work-note {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	.work-note p {
		max-width: 56ch;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.work-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}

		.work-links {
			flex-direction: row;
			gap: 1.25rem;
		}
	}
</style>
