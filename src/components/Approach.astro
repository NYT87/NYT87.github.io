---
// biome-ignore lint/correctness/noUnusedVariables: it is used in the template
const steps = [
	{
		title: "Clarify",
		detail:
			"Turn an ambiguous product idea into a clear scope with testable outcomes.",
	},
	{
		title: "Build",
		detail:
			"Work inside your workflow and ship against measurable milestones, with execution visible from day one.",
	},
	{
		title: "Sustain",
		detail:
			"Leave maintainable architecture and documented decisions your team can keep evolving.",
	},
];
---

<section id="about" class="section" aria-labelledby="about-title">
	<div class="container section-grid">
		<p class="section-index">
			<span>03</span>
			<span>Approach</span>
		</p>
		<div class="section-body">
			<h2 id="about-title" class="section-title">
				A delivery partner for teams building serious software.
			</h2>
			<div class="approach-copy">
				<p class="lead">
					We work with startups and established teams to turn ambiguous product ideas into clear,
					testable software outcomes, with maintainable architecture and predictable delivery.
				</p>
				<p>
					Because we are fully remote and async-capable, we integrate directly into your workflow,
					align around measurable milestones, and keep technical execution transparent from day one.
				</p>
			</div>
			<ol class="index-list steps">
				{steps.map((step, index) => (
					<li class="step">
						<span class="mono-label step-num">{`Step 0${index + 1}`}</span>
						<h3>{step.title}</h3>
						<p>{step.detail}</p>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.approach-copy {
		display: grid;
		gap: 1rem;
		max-width: 62ch;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 0;
	}

	.step {
		display: grid;
		align-content: start;
		gap: 0.6rem;
		padding: 1.5rem 1.5rem 0.5rem 0;
	}

	.step + .step {
		padding-left: 1.5rem;
		border-left: 1px solid var(--border);
	}

	.step-num {
		color: var(--brand-text);
	}

	.step h3 {
		font-size: 1.35rem;
	}

	.step p {
		font-size: 0.98rem;
	}

	@media (max-width: 768px) {
		.steps {
			grid-template-columns: 1fr;
			border-bottom: 1px solid var(--border);
		}

		.step,
		.step + .step {
			padding: 1.25rem 0;
			border-left: 0;
		}
	}
</style>
