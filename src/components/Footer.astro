---
/** biome-ignore-all lint/correctness/noUnusedImports: they are used in the template */
/** biome-ignore-all lint/correctness/noUnusedVariables: they are used in the template */
/** The studio footer: logo, copyright and links on one line, as on the original site. */
import { getImage, Image } from "astro:assets";
import logoText from "../assets/brand/logo-text.png";
import logoTextWhite from "../assets/brand/logo-text-white.png";

const logoTextDark = await getImage({
	src: logoTextWhite,
	height: 20,
	densities: [1, 2],
});
const year = new Date().getFullYear();
---

<footer class="ds-footer site-footer">
	<div class="ds-container site-footer__row">
		<picture>
			<source
				srcset={logoTextDark.srcSet.attribute || logoTextDark.src}
				media="(prefers-color-scheme: dark)"
			/>
			<Image src={logoText} alt="NYT87" height={20} densities={[1, 2]} class="site-footer__logo" />
		</picture>
		<p class="mono-label">&copy; {year} NYT87 · Remote software studio</p>
		<nav class="site-footer__links" aria-label="Site pages">
			<a href="/projects/" class="text-link">
				Projects
			</a>
			<a href="/team/" class="text-link">
				Team
			</a>
			<a href="#main-content" class="text-link">
				Back to top
			</a>
		</nav>
	</div>
</footer>

<style>
	/* The shared footer's spacing and top border are replaced by the studio's single hairline inside the content edges. */
	.site-footer {
		margin-top: 0;
		border-top: 0;
	}

	.site-footer__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 2rem clamp(2rem, 4vw, 3rem);
		background: linear-gradient(var(--line-strong), var(--line-strong)) top center /
			calc(100% - var(--page-gutter) * 2) 1px no-repeat;
	}

	.site-footer__logo {
		height: 20px;
		width: auto;
		display: block;
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		font-size: 0.92rem;
	}

	.site-footer__links a {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		min-height: 32px;
	}
</style>
