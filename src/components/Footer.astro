---
/** biome-ignore-all lint/correctness/noUnusedImports: they are used in the template */
/** biome-ignore-all lint/correctness/noUnusedVariables: they are used in the template */
import { getImage, Image } from "astro:assets";
import logoText from "../assets/brand/logo-text.png";
import logoTextWhite from "../assets/brand/logo-text-white.png";

const logoTextDark = await getImage({
	src: logoTextWhite,
	height: 20,
	densities: [1, 2],
});
---

<footer class="footer">
	<div class="container footer-content">
		<picture>
			<source
				srcset={logoTextDark.srcSet.attribute || logoTextDark.src}
				media="(prefers-color-scheme: dark)"
			/>
			<Image src={logoText} alt="NYT87" height={20} densities={[1, 2]} class="footer-logo" />
		</picture>
		<p class="mono-label">&copy; {new Date().getFullYear()} NYT87 · Remote software studio</p>
		<a href="#main-content" class="text-link footer-top">
			Back to top
		</a>
	</div>
</footer>

<style>
	.footer-content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 2rem clamp(2rem, 4vw, 3rem);
		background: linear-gradient(var(--line-strong), var(--line-strong)) top center /
			calc(100% - var(--page-gutter) * 2) 1px no-repeat;
	}

	.footer-logo {
		height: 20px;
		width: auto;
		display: block;
	}

	.footer-top {
		font-size: 0.92rem;
	}
</style>
